# Track only reviewed source and the assets actually used by the site.
/*
!/.gitignore
!/.gitattributes
!/index.html
!/styles.css
!/motion.css
!/app.js
!/motion.js
!/build.cjs
!/server.cjs
!/package.json
!/README.md
!/DEPLOYMENT.md
!/_headers
!/assets/
/assets/*
!/assets/logo.gif
!/assets/hero-01.jpg
!/assets/hero-02.jpg
!/assets/pipe-thumb.jpg
!/assets/coil-thumb.jpg
!/assets/bar-thumb.jpg
!/assets/steel-pipes.svg
!/assets/favicon.svg
!/assets/PretendardVariable.woff2
!/assets/inter-latin.woff2
!/assets/Hahmlet-Variable.woff2
!/assets/PRETENDARD-LICENSE.txt
!/assets/INTER-LICENSE.txt
!/assets/HAHMLET-LICENSE.txt
!/assets/ASSET-SOURCES.md
!/preview.ps1
!/미리보기.cmd
